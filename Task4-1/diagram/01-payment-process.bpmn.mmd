bpmn LR
layout elk

pool payment_process "Процесс обработки\ платежа"
  lane saga "Сага платежа"
    message start payment_initiated "Инициация платежа"
    service task debit_payer "Списать средства\ плательщика"
      error boundary debit_failed "Ошибка списания"
    subprocess transaction_checks "Выполнить проверки\ операции"
      parallel gate checks_fork
        port checks_fraud_out n
        port checks_external_out s
      service task fraud_check "Выполнить\ антифрод-проверку"
      service task external_checks "Выполнить проверки\ соответствия\ требованиям и\ ограничений"
      parallel gate checks_join
      checks_fraud_out --> fraud_check
      checks_external_out --> external_checks
      fraud_check --> checks_join
      external_checks --> checks_join
      timer boundary check_cutoff "Контрольный срок\ проверки"
      error boundary check_failed "Ошибка проверки"
    exclusive gate fraud_outcome "Результат\ FraudCheck?"
      port fraud_approved_out n
      port fraud_suspicious_out s
    user task manual_review "Ручная проверка\ оператором"
    event gate await_manual_review "Ожидание решения\ ручной проверки или\ истечения\ контрольного срока"
      port manual_decision_out n
      port manual_cutoff_out s
    message catch manual_decision "Решение ручной\ проверки"
    timer catch manual_review_cutoff "20 минут"
    exclusive gate manual_outcome "Платёж одобрен?"
      port manual_approved_out n
      port manual_denied_out s
    service task transfer_to_payee "Перевести средства\ получателю"
      error boundary transfer_failed "Ошибка перевода"
    comment transfer_pivot "Pivot-точка —\ перевод получателю\ необратим" e
    parallel gate suspicious_fork
      port security_notification_out n
      port suspicious_refund_out s
    send task notify_security "Уведомить Security\ System"
    parallel gate suspicious_join
    compensation task refund_payer "Автоматически\ вернуть средства\ плательщику"
    exclusive gate refund_result "Причина возврата?"
      port suspicious_refund_outcome n
      port other_refund_outcome s
    exclusive gate payment_result "Результат платежа?"
      port completed_notification_out n
      port refunded_notification_out s
    send task notify_completed "Отправить\ уведомление о\ завершённом платеже"
    send task notify_refunded "Отправить\ уведомление о\ возврате средств"
    end payment_completed "PAYMENT_COMPLETED"
    end payment_refunded "PAYMENT_REFUNDED"
    error end payment_failed "PAYMENT_FAILED_SYSTEM"

    payment_initiated --> debit_payer
    debit_payer --> transaction_checks
    debit_failed --> payment_failed

    transaction_checks --> fraud_outcome
    check_cutoff --> transfer_to_payee "по умолчанию:\ одобрено"
    check_failed --> refund_payer

    fraud_approved_out --> transfer_to_payee "одобрено"
    fraud_outcome --> manual_review "требуется ручная\ проверка"
    fraud_outcome --> refund_payer "отклонено"
    fraud_suspicious_out --> suspicious_fork "подозрительная\ операция"

    manual_review --> await_manual_review
    manual_decision_out --> manual_decision "решение получено"
    manual_cutoff_out --> manual_review_cutoff "решение не получено"
    manual_decision --> manual_outcome
    manual_review_cutoff --> transfer_to_payee "по умолчанию:\ одобрено"
    manual_approved_out --> transfer_to_payee "одобрено"
    manual_denied_out --> refund_payer "отклонено"

    transfer_to_payee --> payment_result
    transfer_to_payee --- transfer_pivot
    transfer_failed --> refund_payer

    security_notification_out --> notify_security
    suspicious_refund_out --> refund_payer
    notify_security --> suspicious_join
    refund_payer --> refund_result
    suspicious_refund_outcome --> suspicious_join "подозрительная\ операция"
    other_refund_outcome --> payment_result "отклонён или\ завершился ошибкой"
    suspicious_join --> payment_result

    completed_notification_out --> notify_completed "завершён"
    refunded_notification_out --> notify_refunded "средства возвращены"
    notify_completed --> payment_completed
    notify_refunded --> payment_refunded

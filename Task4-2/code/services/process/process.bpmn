<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="payment_process_definitions" targetNamespace="urn:orchestrpay:payment">

  <bpmn:message id="payment_initiated_message" name="PaymentInitiatedFact" />
  <bpmn:error id="debit_failed_error" name="Ошибка списания" errorCode="DEBIT_FAILED" />
  <bpmn:error id="check_failed_error" name="Ошибка проверки" errorCode="CHECK_FAILED" />
  <bpmn:error id="transfer_failed_error" name="Ошибка перевода" errorCode="TRANSFER_FAILED" />
  <bpmn:error id="payment_failed_system_error" name="PAYMENT_FAILED_SYSTEM" errorCode="PAYMENT_FAILED_SYSTEM" />

  <bpmn:process id="payment_process" name="Процесс обработки платежа" isExecutable="true">
    <bpmn:documentation><![CDATA[
Start message: PaymentInitiatedFact.
Required variables: payment_id, payer_id, payee_id, currency (strings), amount (positive number).
Payment Service owns DEBIT_PAYER_FUNDS, TRANSFER_FUNDS_TO_PAYEE, REFUND_PAYER and ROLLBACK_PAYMENT_STATUS.
FraudCheck Service owns PERFORM_FRAUD_CHECK and PERFORM_EXTERNAL_CHECKS.
Notification Service owns NOTIFY_SECURITY_SYSTEM and SEND_PAYMENT_STATUS_NOTIFICATION.
Workers read the payment variables inherited from the process instance.
PERFORM_FRAUD_CHECK must return fraud_result: approved, denied, suspicious or manual_review_required.
PERFORM_EXTERNAL_CHECKS completes only after all simulated external checks pass; a failed check throws CHECK_FAILED.
Either check worker may throw CHECK_FAILED. The checks deadline is 30 seconds.
Manual review returns manual_decision: approved or denied. Its deadline is 20 minutes from task activation.
Both deadlines reject the payment and trigger refund and payment-status rollback.
DEBIT_FAILED means no payer funds were captured; TRANSFER_FAILED means the payee transfer did not take effect.
Do not throw TRANSFER_FAILED for an unknown transfer outcome or an already completed transfer.
Refund, rollback and notification workers must be idempotent and retry transient failures.
Compensation failures must not complete the refund task or advance to a refunded outcome.
The BPMN mappings own refund_reason and payment_outcome; workers must not overwrite them.
refund_reason: denied, suspicious, manual_denied, check_cutoff, check_failed, transfer_failed or manual_review_cutoff; null when no refund is required.
payment_outcome: completed after successful transfer, refunded after successful refund and payment-status rollback, or failed_system after a failed debit.
SEND_PAYMENT_STATUS_NOTIFICATION reads payment_outcome to select the payer notification.
      ]]></bpmn:documentation>

    <bpmn:startEvent id="payment_initiated" name="Инициация платежа">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;payment_id&#34;: &#34;payment-001&#34;,&#10;  &#34;payer_id&#34;: &#34;payer-001&#34;,&#10;  &#34;payee_id&#34;: &#34;payee-001&#34;,&#10;  &#34;currency&#34;: &#34;RUB&#34;,&#10;  &#34;amount&#34;: 100&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>payment_initiated_to_debit_payer</bpmn:outgoing>
      <bpmn:messageEventDefinition id="payment_initiated_message_definition" messageRef="payment_initiated_message" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="debit_payer" name="DEBIT_PAYER_FUNDS Списать средства плательщика">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="DEBIT_PAYER_FUNDS" />
      </bpmn:extensionElements>
      <bpmn:incoming>payment_initiated_to_debit_payer</bpmn:incoming>
      <bpmn:outgoing>debit_payer_to_transaction_checks</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="debit_failed" name="Ошибка списания" attachedToRef="debit_payer" cancelActivity="true">
      <bpmn:outgoing>debit_failed_to_payment_failed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="debit_failed_error_definition" errorRef="debit_failed_error" />
    </bpmn:boundaryEvent>

    <bpmn:subProcess id="transaction_checks" name="PERFORM_FRAUD_CHECK Выполнить проверки операции">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="fraud_result" />
          <zeebe:input source="=null" target="refund_reason" />
          <zeebe:output source="=fraud_result" target="fraud_result" />
          <zeebe:output source="=refund_reason" target="refund_reason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>debit_payer_to_transaction_checks</bpmn:incoming>
      <bpmn:outgoing>transaction_checks_to_fraud_outcome</bpmn:outgoing>

      <bpmn:startEvent id="checks_started" name="Начало проверок">
        <bpmn:outgoing>checks_started_to_checks_fork</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:parallelGateway id="checks_fork" gatewayDirection="Diverging">
        <bpmn:incoming>checks_started_to_checks_fork</bpmn:incoming>
        <bpmn:outgoing>checks_fork_to_fraud_check</bpmn:outgoing>
        <bpmn:outgoing>checks_fork_to_external_checks</bpmn:outgoing>
      </bpmn:parallelGateway>

      <bpmn:serviceTask id="fraud_check" name="Выполнить антифрод-проверку">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="PERFORM_FRAUD_CHECK" />
          <zeebe:ioMapping>
            <zeebe:output source="=fraud_result" target="fraud_result" />
            <zeebe:output source="=if fraud_result = &quot;suspicious&quot; then &quot;suspicious&quot; else if fraud_result = &quot;denied&quot; then &quot;denied&quot; else null" target="refund_reason" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>checks_fork_to_fraud_check</bpmn:incoming>
        <bpmn:outgoing>fraud_check_to_checks_join</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="external_checks" name="Выполнить проверки соответствия требованиям и ограничений">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="PERFORM_EXTERNAL_CHECKS" />
        </bpmn:extensionElements>
        <bpmn:incoming>checks_fork_to_external_checks</bpmn:incoming>
        <bpmn:outgoing>external_checks_to_checks_join</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:parallelGateway id="checks_join" gatewayDirection="Converging">
        <bpmn:incoming>fraud_check_to_checks_join</bpmn:incoming>
        <bpmn:incoming>external_checks_to_checks_join</bpmn:incoming>
        <bpmn:outgoing>checks_join_to_checks_completed</bpmn:outgoing>
      </bpmn:parallelGateway>

      <bpmn:endEvent id="checks_completed" name="Проверки завершены">
        <bpmn:incoming>checks_join_to_checks_completed</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="checks_started_to_checks_fork" sourceRef="checks_started" targetRef="checks_fork" />
      <bpmn:sequenceFlow id="checks_fork_to_fraud_check" sourceRef="checks_fork" targetRef="fraud_check" />
      <bpmn:sequenceFlow id="checks_fork_to_external_checks" sourceRef="checks_fork" targetRef="external_checks" />
      <bpmn:sequenceFlow id="fraud_check_to_checks_join" sourceRef="fraud_check" targetRef="checks_join" />
      <bpmn:sequenceFlow id="external_checks_to_checks_join" sourceRef="external_checks" targetRef="checks_join" />
      <bpmn:sequenceFlow id="checks_join_to_checks_completed" sourceRef="checks_join" targetRef="checks_completed" />

    </bpmn:subProcess>

    <bpmn:boundaryEvent id="check_cutoff" name="Контрольный срок проверки: 30 секунд" attachedToRef="transaction_checks" cancelActivity="true">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;check_cutoff&quot;" target="refund_reason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>check_cutoff_to_refund_payer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="check_cutoff_timer_definition">
        <bpmn:timeDuration>PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="check_failed" name="Ошибка проверки" attachedToRef="transaction_checks" cancelActivity="true">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;check_failed&quot;" target="refund_reason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>check_failed_to_refund_payer</bpmn:outgoing>
      <bpmn:errorEventDefinition id="check_failed_error_definition" errorRef="check_failed_error" />
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="fraud_outcome" name="Результат FraudCheck?" gatewayDirection="Diverging">
      <bpmn:incoming>transaction_checks_to_fraud_outcome</bpmn:incoming>
      <bpmn:outgoing>fraud_outcome_to_transfer_to_payee</bpmn:outgoing>
      <bpmn:outgoing>fraud_outcome_to_refund_payer</bpmn:outgoing>
      <bpmn:outgoing>fraud_outcome_to_suspicious_fork</bpmn:outgoing>
      <bpmn:outgoing>fraud_outcome_to_manual_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="manual_review" name="Ручная проверка оператором">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="manual_review_form" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="manual_decision" />
          <zeebe:output source="=manual_decision" target="manual_decision" />
          <zeebe:output source="=if manual_decision = &quot;denied&quot; then &quot;manual_denied&quot; else null" target="refund_reason" />
        </zeebe:ioMapping>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>fraud_outcome_to_manual_review</bpmn:incoming>
      <bpmn:outgoing>manual_review_to_manual_outcome</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="manual_review_cutoff" name="20 минут" attachedToRef="manual_review" cancelActivity="true">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;manual_review_cutoff&quot;" target="refund_reason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>manual_review_cutoff_to_refund_payer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="manual_review_cutoff_timer_definition">
        <bpmn:timeDuration>PT20M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="manual_outcome" name="Платёж одобрен?" gatewayDirection="Diverging">
      <bpmn:incoming>manual_review_to_manual_outcome</bpmn:incoming>
      <bpmn:outgoing>manual_outcome_to_transfer_to_payee</bpmn:outgoing>
      <bpmn:outgoing>manual_outcome_to_refund_payer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="transfer_to_payee_merge" gatewayDirection="Converging">
      <bpmn:incoming>fraud_outcome_to_transfer_to_payee</bpmn:incoming>
      <bpmn:incoming>manual_outcome_to_transfer_to_payee</bpmn:incoming>
      <bpmn:outgoing>transfer_to_payee_merge_to_task</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="transfer_to_payee" name="TRANSFER_FUNDS_TO_PAYEE Перевести средства получателю">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="TRANSFER_FUNDS_TO_PAYEE" />
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;completed&quot;" target="payment_outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>transfer_to_payee_merge_to_task</bpmn:incoming>
      <bpmn:outgoing>transfer_to_payee_to_payment_result</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="transfer_failed" name="Ошибка перевода" attachedToRef="transfer_to_payee" cancelActivity="true">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;transfer_failed&quot;" target="refund_reason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>transfer_failed_to_refund_payer</bpmn:outgoing>
      <bpmn:errorEventDefinition id="transfer_failed_error_definition" errorRef="transfer_failed_error" />
    </bpmn:boundaryEvent>

    <bpmn:parallelGateway id="suspicious_fork" gatewayDirection="Diverging">
      <bpmn:incoming>fraud_outcome_to_suspicious_fork</bpmn:incoming>
      <bpmn:outgoing>suspicious_fork_to_refund_payer</bpmn:outgoing>
      <bpmn:outgoing>suspicious_fork_to_notify_security</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="notify_security" name="NOTIFY_SECURITY_SYSTEM Уведомить Security System">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="NOTIFY_SECURITY_SYSTEM" />
      </bpmn:extensionElements>
      <bpmn:incoming>suspicious_fork_to_notify_security</bpmn:incoming>
      <bpmn:outgoing>notify_security_to_suspicious_join</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:exclusiveGateway id="refund_payer_merge" gatewayDirection="Converging">
      <bpmn:incoming>check_cutoff_to_refund_payer</bpmn:incoming>
      <bpmn:incoming>check_failed_to_refund_payer</bpmn:incoming>
      <bpmn:incoming>transfer_failed_to_refund_payer</bpmn:incoming>
      <bpmn:incoming>fraud_outcome_to_refund_payer</bpmn:incoming>
      <bpmn:incoming>suspicious_fork_to_refund_payer</bpmn:incoming>
      <bpmn:incoming>manual_review_cutoff_to_refund_payer</bpmn:incoming>
      <bpmn:incoming>manual_outcome_to_refund_payer</bpmn:incoming>
      <bpmn:outgoing>refund_payer_merge_to_task</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="refund_payer" name="REFUND_PAYER Автоматически вернуть средства плательщику">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="REFUND_PAYER" />
      </bpmn:extensionElements>
      <bpmn:incoming>refund_payer_merge_to_task</bpmn:incoming>
      <bpmn:outgoing>refund_payer_to_rollback_payment_status</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="rollback_payment_status" name="ROLLBACK_PAYMENT_STATUS Восстановить статус платежа">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ROLLBACK_PAYMENT_STATUS" />
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;refunded&quot;" target="payment_outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>refund_payer_to_rollback_payment_status</bpmn:incoming>
      <bpmn:outgoing>rollback_payment_status_to_refund_result</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="refund_result" name="Причина возврата?" gatewayDirection="Diverging">
      <bpmn:incoming>rollback_payment_status_to_refund_result</bpmn:incoming>
      <bpmn:outgoing>refund_result_to_suspicious_join</bpmn:outgoing>
      <bpmn:outgoing>refund_result_to_payment_result</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="suspicious_join" gatewayDirection="Converging">
      <bpmn:incoming>notify_security_to_suspicious_join</bpmn:incoming>
      <bpmn:incoming>refund_result_to_suspicious_join</bpmn:incoming>
      <bpmn:outgoing>suspicious_join_to_payment_result</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="payment_result_merge" gatewayDirection="Converging">
      <bpmn:incoming>transfer_to_payee_to_payment_result</bpmn:incoming>
      <bpmn:incoming>suspicious_join_to_payment_result</bpmn:incoming>
      <bpmn:incoming>refund_result_to_payment_result</bpmn:incoming>
      <bpmn:outgoing>payment_result_merge_to_decision</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="payment_result" name="Результат платежа?" gatewayDirection="Diverging">
      <bpmn:incoming>payment_result_merge_to_decision</bpmn:incoming>
      <bpmn:outgoing>payment_result_to_notify_completed</bpmn:outgoing>
      <bpmn:outgoing>payment_result_to_notify_refunded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="notify_completed" name="SEND_PAYMENT_STATUS_NOTIFICATION Уведомить о завершении платежа">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="SEND_PAYMENT_STATUS_NOTIFICATION" />
      </bpmn:extensionElements>
      <bpmn:incoming>payment_result_to_notify_completed</bpmn:incoming>
      <bpmn:outgoing>notify_completed_to_payment_completed</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="notify_refunded" name="SEND_PAYMENT_STATUS_NOTIFICATION Уведомить о возврате средств">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="SEND_PAYMENT_STATUS_NOTIFICATION" />
      </bpmn:extensionElements>
      <bpmn:incoming>payment_result_to_notify_refunded</bpmn:incoming>
      <bpmn:outgoing>notify_refunded_to_payment_refunded</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="payment_completed" name="PAYMENT_COMPLETED">
      <bpmn:incoming>notify_completed_to_payment_completed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="payment_refunded" name="PAYMENT_REFUNDED">
      <bpmn:incoming>notify_refunded_to_payment_refunded</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="payment_failed" name="PAYMENT_FAILED_SYSTEM">
      <bpmn:incoming>debit_failed_to_payment_failed</bpmn:incoming>
      <bpmn:errorEventDefinition id="payment_failed_system_error_definition" errorRef="payment_failed_system_error" />
    </bpmn:endEvent>

    <bpmn:subProcess id="payment_failure_handler" name="Завершить платёж после ошибки списания" triggeredByEvent="true">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;failed_system&quot;" target="payment_outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:startEvent id="payment_failure_caught" name="Ошибка платёжной операции" isInterrupting="true">
        <bpmn:outgoing>payment_failure_caught_to_payment_failure_handled</bpmn:outgoing>
        <bpmn:errorEventDefinition id="payment_failure_caught_error_definition" errorRef="payment_failed_system_error" />
      </bpmn:startEvent>
      <bpmn:endEvent id="payment_failure_handled" name="Платёж завершён с ошибкой">
        <bpmn:incoming>payment_failure_caught_to_payment_failure_handled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="payment_failure_caught_to_payment_failure_handled" sourceRef="payment_failure_caught" targetRef="payment_failure_handled" />
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="payment_initiated_to_debit_payer" sourceRef="payment_initiated" targetRef="debit_payer" />
    <bpmn:sequenceFlow id="debit_failed_to_payment_failed" sourceRef="debit_failed" targetRef="payment_failed" />
    <bpmn:sequenceFlow id="debit_payer_to_transaction_checks" sourceRef="debit_payer" targetRef="transaction_checks" />
    <bpmn:sequenceFlow id="transaction_checks_to_fraud_outcome" sourceRef="transaction_checks" targetRef="fraud_outcome" />
    <bpmn:sequenceFlow id="fraud_outcome_to_transfer_to_payee" name="одобрено" sourceRef="fraud_outcome" targetRef="transfer_to_payee_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fraud_result = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="transfer_to_payee_merge_to_task" sourceRef="transfer_to_payee_merge" targetRef="transfer_to_payee" />
    <bpmn:sequenceFlow id="check_cutoff_to_refund_payer" sourceRef="check_cutoff" targetRef="refund_payer_merge" />
    <bpmn:sequenceFlow id="check_failed_to_refund_payer" sourceRef="check_failed" targetRef="refund_payer_merge" />
    <bpmn:sequenceFlow id="transfer_failed_to_refund_payer" sourceRef="transfer_failed" targetRef="refund_payer_merge" />
    <bpmn:sequenceFlow id="fraud_outcome_to_refund_payer" name="отклонено" sourceRef="fraud_outcome" targetRef="refund_payer_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fraud_result = "denied"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="refund_payer_to_rollback_payment_status" sourceRef="refund_payer" targetRef="rollback_payment_status" />
    <bpmn:sequenceFlow id="rollback_payment_status_to_refund_result" sourceRef="rollback_payment_status" targetRef="refund_result" />
    <bpmn:sequenceFlow id="fraud_outcome_to_suspicious_fork" name="подозрительная операция" sourceRef="fraud_outcome" targetRef="suspicious_fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fraud_result = "suspicious"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="suspicious_fork_to_refund_payer" sourceRef="suspicious_fork" targetRef="refund_payer_merge" />
    <bpmn:sequenceFlow id="suspicious_fork_to_notify_security" sourceRef="suspicious_fork" targetRef="notify_security" />
    <bpmn:sequenceFlow id="notify_security_to_suspicious_join" sourceRef="notify_security" targetRef="suspicious_join" />
    <bpmn:sequenceFlow id="refund_result_to_suspicious_join" name="подозрительная операция" sourceRef="refund_result" targetRef="suspicious_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refund_reason = "suspicious"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="transfer_to_payee_to_payment_result" sourceRef="transfer_to_payee" targetRef="payment_result_merge" />
    <bpmn:sequenceFlow id="suspicious_join_to_payment_result" sourceRef="suspicious_join" targetRef="payment_result_merge" />
    <bpmn:sequenceFlow id="refund_result_to_payment_result" name="отклонён или завершился ошибкой" sourceRef="refund_result" targetRef="payment_result_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refund_reason != "suspicious"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="payment_result_to_notify_completed" name="завершён" sourceRef="payment_result" targetRef="notify_completed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= payment_outcome = "completed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="payment_result_to_notify_refunded" name="средства возвращены" sourceRef="payment_result" targetRef="notify_refunded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= payment_outcome = "refunded"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="notify_completed_to_payment_completed" sourceRef="notify_completed" targetRef="payment_completed" />
    <bpmn:sequenceFlow id="notify_refunded_to_payment_refunded" sourceRef="notify_refunded" targetRef="payment_refunded" />
    <bpmn:sequenceFlow id="fraud_outcome_to_manual_review" name="требуется ручная проверка" sourceRef="fraud_outcome" targetRef="manual_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fraud_result = "manual_review_required"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="manual_review_cutoff_to_refund_payer" sourceRef="manual_review_cutoff" targetRef="refund_payer_merge" />
    <bpmn:sequenceFlow id="manual_review_to_manual_outcome" sourceRef="manual_review" targetRef="manual_outcome" />
    <bpmn:sequenceFlow id="manual_outcome_to_transfer_to_payee" name="одобрено" sourceRef="manual_outcome" targetRef="transfer_to_payee_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manual_decision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="manual_outcome_to_refund_payer" name="отклонено" sourceRef="manual_outcome" targetRef="refund_payer_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manual_decision = "denied"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="refund_payer_merge_to_task" sourceRef="refund_payer_merge" targetRef="refund_payer" />
    <bpmn:sequenceFlow id="payment_result_merge_to_decision" sourceRef="payment_result_merge" targetRef="payment_result" />

  </bpmn:process>

